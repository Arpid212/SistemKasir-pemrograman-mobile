<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="@color/surface_white">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFotoKeranjang"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize10Percent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tvKategoriKeranjang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/imgFotoKeranjang"
        app:layout_constraintTop_toTopOf="@id/imgFotoKeranjang"
        tools:text="Kategori" />

    <TextView
        android:id="@+id/tvNamaKeranjang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvHargaKeranjang"
        app:layout_constraintStart_toEndOf="@id/imgFotoKeranjang"
        app:layout_constraintTop_toBottomOf="@id/tvKategoriKeranjang"
        tools:text="Nama Produk" />

    <TextView
        android:id="@+id/tvKuantitasKeranjang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/imgFotoKeranjang"
        app:layout_constraintTop_toBottomOf="@id/tvNamaKeranjang"
        tools:text="Quantity: 1" />

    <TextView
        android:id="@+id/tvHargaKeranjang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvKategoriKeranjang"
        tools:text="Rp 25.000" />

</androidx.constraintlayout.widget.ConstraintLayout>