<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Tambah Kasir Baru"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputNamaLenagkap"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="32dp"
        android:background="#F5F5F5"
        android:hint="Nama Lengkap (Contoh: Budi Santoso)"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Tombol Batal bergaya sekunder (Abu-abu) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatal"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:text="Batal"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="#F5F5F5"
            app:cornerRadius="8dp" />

        <!-- Tombol Simpan bergaya utama (Hitam) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Simpan"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="#000000"
            app:cornerRadius="8dp" />
    </LinearLayout>
</LinearLayout>