<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Tambah Menu Baru"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtNama"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:hint="Nama Produk"
        android:paddingHorizontal="16dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spKategori"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:paddingHorizontal="12dp" />

    <EditText
        android:id="@+id/edtHarga"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="#F5F5F5"
        android:hint="Harga (Rp)"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- FOTO, DESKRIPSI, STOK dalam satu baris -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtFoto"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:hint="Foto (URL)"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtDeskripsi"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:hint="Deskripsi"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edtStok"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:hint="Stok"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SIMPAN MENU"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#000000"
        app:cornerRadius="8dp" />

</LinearLayout>